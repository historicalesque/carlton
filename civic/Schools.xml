          <row><cell>Stevenson, Miss, school</cell><cell><ref target="civic?id=Madeline%20Street">Madeline Street</ref></cell><cell>117</cell><cell>1870</cell></row>
          <row><cell>Cullimore, F. W., teacher of piano</cell><cell><ref target="civic?id=Victoria%20Street">Victoria Street</ref></cell><cell>19</cell><cell>1870–1871</cell></row>
          <row><cell>Salter, Mrs., teacher of music</cell><cell><ref target="civic?id=Grattan%20Street">Grattan Street</ref></cell><cell></cell><cell>1871</cell></row>
