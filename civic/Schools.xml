          <row><cell>Lowrey, Misses, school</cell><cell><ref target="civic?id=Leicester%20Street">Leicester Street</ref></cell><cell>110, 106</cell><cell>1872–1876</cell></row>
          <row><cell>Bailey, W., school</cell><cell><ref target="civic?id=Madeline%20Street">Madeline Street</ref></cell><cell>65</cell><cell>1873</cell></row>
          <row><cell>Poitou, Madame, teacher of French</cell><cell><ref target="civic?id=Barry%20Street">Barry Street</ref></cell><cell>16</cell><cell>1873</cell></row>
          <row><cell>Delany, Miss, school</cell><cell><ref target="civic?id=Ballarat%20Street">Ballarat Street</ref></cell><cell></cell><cell>1873–1875</cell></row>
